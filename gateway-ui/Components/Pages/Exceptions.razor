@page "/exceptions"
@using GatewayUI.Models
@using GatewayUI.Services
@inject IGatewayApi Api
@implements IDisposable

<PageTitle>Exceptions</PageTitle>

<div class="py-3">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h3 class="mb-0">Human review queue</h3>
        <div class="d-flex gap-2 align-items-center">
            <span class="small text-secondary">role: <code>@Api.CurrentRole</code></span>
            <button class="btn btn-outline-secondary btn-sm" @onclick="LoadAsync">Refresh</button>
        </div>
    </div>

    <ViewState T="ExceptionsDto" Result="_result" Loading="@_loading">
        @if (_result!.Data is { } d)
        {
            <div class="alert alert-secondary">
                <strong>These are cases the policy engine deliberately declined to auto-resolve</strong>
                (escalated / abandoned / waiting-on-PTP) — not failures of the system. Each needs a human reviewer.
                Customer fields are redacted server-side.
            </div>

            @foreach (var group in Grouped)
            {
                <div class="card mb-2">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <strong>@group.Key</strong>
                        <span class="badge bg-secondary">@group.Count()</span>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Event</th><th>Flow</th><th>Customer</th><th>Invoice</th>
                                    <th class="text-end">Amount</th><th>Rule</th><th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var x in group)
                                {
                                    <tr>
                                        <td><code>@x.EventId</code></td>
                                        <td>@x.Flow</td>
                                        <td>@x.Customer</td>
                                        <td>@x.Invoice</td>
                                        <td class="text-end">@Inr(x.AmountInRupees)</td>
                                        <td><span class="badge bg-secondary">@x.RuleFired</span></td>
                                        <td><span class="badge @StatusClass(x.Status)">@x.Status</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        }
    </ViewState>
</div>

@code {
    private ApiResult<ExceptionsDto>? _result;
    private bool _loading;
    private List<IGrouping<string, ExceptionDto>> Grouped = new();

    protected override async Task OnInitializedAsync()
    {
        Api.RoleChanged += OnRoleChanged;
        await LoadAsync();
    }

    private async void OnRoleChanged() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _result = null;
        Grouped = new();
        StateHasChanged();
        _result = await Api.GetExceptionsAsync();
        if (_result.Ok && _result.Data?.Exceptions is { } items)
        {
            Grouped = items.GroupBy(x => x.Reason ?? "other")
                           .OrderBy(g => g.Key)
                           .ToList();
        }
        _loading = false;
        StateHasChanged();
    }

    private static string StatusClass(string? s) => s switch
    {
        "escalated" => "bg-warning text-dark",
        "abandoned" => "bg-secondary",
        "waiting_on_ptp" => "bg-info text-dark",
        _ => "bg-secondary"
    };

    private static string Inr(double v) => "₹" + v.ToString("N2");

    public void Dispose() => Api.RoleChanged -= OnRoleChanged;
}
