@page "/prescore"
@using GatewayUI.Models
@using GatewayUI.Services
@inject IGatewayApi Api
@implements IDisposable

<PageTitle>Risk Prescore</PageTitle>

<div class="py-3">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h3 class="mb-0">Risk Prescore (predict-before-fail)</h3>
        <div class="d-flex gap-2 align-items-center">
            <span class="small text-secondary">role: <code>@Api.CurrentRole</code></span>
            <button class="btn btn-outline-secondary btn-sm" @onclick="LoadAsync">Refresh</button>
        </div>
    </div>

    <ViewState T="PrescoreDto" Result="_result" Loading="@_loading">
        @if (_result!.Data is { } p)
        {
            <div class="card mb-3">
                <div class="card-body">
                    <h5 class="card-title">Overall recall &amp; precision</h5>
                    <div class="d-flex gap-4">
                        <div>
                            <div class="text-muted small">Recall</div>
                            <div class="fs-4 fw-semibold">@Pct(p.Recall)</div>
                            <div class="small text-secondary">@p.HighRiskAmongFailed of @p.FailedEvents non-recovered were pre-flagged high-risk</div>
                        </div>
                        <div>
                            <div class="text-muted small">Precision</div>
                            <div class="fs-4 fw-semibold">@Pct(p.Precision)</div>
                            <div class="small text-secondary">@p.HighRiskAmongFailed of @p.HighRiskTotal high-risk truly failed</div>
                        </div>
                    </div>
                    <div class="alert alert-light small mb-0 mt-3"><strong>Backend headline:</strong> @p.Headline</div>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
                    <span>@p.Rows!.Count events (click a column header to sort)</span>
                </div>
                <div class="table-responsive" style="max-height: 65vh; overflow-y: auto;">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th role="button" @onclick="() => SortBy(e => e.EventId)">Event</th>
                                <th role="button" @onclick="() => SortBy(e => e.Flow)">Flow</th>
                                <th role="button" @onclick="() => SortBy(e => e.Score)">Risk score</th>
                                <th>Tier</th>
                                <th role="button" @onclick="() => SortBy(e => e.TopFactor)">Top factor</th>
                                <th>Actual outcome</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _ordered)
                            {
                                <tr>
                                    <td><code>@row.EventId</code></td>
                                    <td>@row.Flow</td>
                                    <td class="fw-semibold">@row.Score/100</td>
                                    <td><span class="badge @TierClass(row.Tier)">@(row.Tier ?? "-")</span></td>
                                    <td>@row.TopFactor</td>
                                    <td>
                                        @if (row.Recovered)
                                        {
                                            <span class="text-success fw-semibold">&#10003; recovered</span>
                                        }
                                        else
                                        {
                                            <span class="text-danger fw-semibold">&#10007; NOT recovered</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </ViewState>
</div>

@code {
    private ApiResult<PrescoreDto>? _result;
    private bool _loading;
    private List<PrescoreRowDto> _ordered = new();

    protected override async Task OnInitializedAsync()
    {
        Api.RoleChanged += OnRoleChanged;
        await LoadAsync();
    }

    private async void OnRoleChanged() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _result = null;
        _ordered = new();
        StateHasChanged();
        _result = await Api.GetPrescoreAsync();
        if (_result.Ok && _result.Data?.Rows is { } rows)
        {
            _ordered = rows.OrderBy(r => r.EventId).ToList();
        }
        _loading = false;
        StateHasChanged();
    }

    private void SortBy<TKey>(Func<PrescoreRowDto, TKey> selector)
    {
        _ordered = _ordered.OrderBy(selector).ToList();
        StateHasChanged();
    }

    private static string TierClass(string? tier) => tier switch
    {
        "high" => "bg-danger",
        "medium" => "bg-warning text-dark",
        "low" => "bg-success",
        _ => "bg-secondary"
    };

    private static string Pct(double v) => (v * 100).ToString("0.0") + "%";

    public void Dispose() => Api.RoleChanged -= OnRoleChanged;
}
